<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>Mon Profil</title>
</head>
<body style="font-family: sans-serif; background-color: #f4f6f9; padding: 50px;">
    <div style="max-width: 500px; margin: 0 auto; background: white; padding: 30px; border-radius: 8px; box-shadow: 0 4px 6px rgba(0,0,0,0.1);">
        <a href="{{ path('app_home') }}">⬅️ Retour à la boutique</a>
        
        <h2 style="color: #333; margin-top: 20px;">👤 Mon Profil Sécurisé</h2>
        <hr style="border: 0; border-top: 1px solid #eee; margin: 20px 0;">
        
        <p><strong>Adresse Email :</strong> {{ user.email }}</p>
        <p><strong>Rôles assignés :</strong> {{ user.roles|join(', ') }}</p>
        
        <div style="margin-top: 30px; background: #e8f4fd; padding: 15px; border-radius: 4px; border-left: 4px solid #007bff;">
            🔒 Cette page est protégée. Seuls les utilisateurs connectés peuvent la voir !
        </div>
    </div>
</body>
</html>